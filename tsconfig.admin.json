{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "removeComments": true,
    "rootDir": "src",
    "outDir": ".build/admin-src"
  },
  "include": ["src/admin/**/*.ts", "src/data/model.ts", "src/data/seed.ts", "src/components/symbols.ts"]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".build"
  },
  "include": ["scripts/**/*.ts", "src/data/**/*.ts", "src/components/**/*.ts", "src/pages/**/*.ts", "src/lib/**/*.ts"]
}

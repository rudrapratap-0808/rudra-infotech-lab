# Public/build-time Supabase connection (safe to expose; RLS limits access)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_SB_PUBLISHABLE_KEY

# Server-only — never expose in browser code or commit real values
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_OR_SB_SECRET_KEY
DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
IP_SALT=GENERATE_A_RANDOM_32_PLUS_CHARACTER_SECRET

# Optional canonical domain override
SITE_URL=https://rudra-infotech-lab.vercel.app

# Optional store-first enquiry email notification
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "removeComments": true,
    "rootDir": "src/client",
    "outDir": ".build/client"
  },
  "include": ["src/client/**/*.ts"]
}

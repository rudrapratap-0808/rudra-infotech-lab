{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "removeComments": true,
    "rootDir": "src/client",
    "outDir": ".build/client"
  },
  "include": ["src/client/**/*.ts", "vendor/gsap/types/index.d.ts"]
}
